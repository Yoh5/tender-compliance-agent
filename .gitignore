# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Secrets — never commit. See .env.example for the shape.
.env
.env.local

# Tender packs and evidence libraries are real documents belonging to real
# companies. They are inputs, not source: keep them out of a public repository.
samples/private/
*.pdf
!docs/**/*.pdf

# Exception. The files under samples/real_dce/ are consultation rules published
# by public buyers — two French, two English — freely downloadable by anyone
# without registration: the buyer's own text, not a bidder's evidence. They are
# committed because the tests assert claims about them that a reader should be
# able to check: page 13 of the ANTAI file names a mandatory document that no
# text extractor returns, and not one sentence of the English packs is read as
# French (nor the reverse), which is what decides whether a translation is
# printed.
!samples/real_dce/*.pdf

# Derived from those PDFs in one command; not worth versioning.
samples/real_dce/*.txt

# Rendered from architecture.svg by scripts/make_deck.py, and embedded in the
# deck. Two copies of one diagram drift, and the one that drifts is the one
# nobody opens — so only the SVG is versioned.
docs/architecture.png

# Generated reports
out/

# Fichiers de verrouillage Office, crees quand le deck est ouvert.
~$*
