# Secrets for the agent runtime. Copy to `.env` and fill in.
# Never commit the filled file — `.gitignore` covers it.

# ---------------------------------------------------------------------------
# The model that reads the consultation file and proposes matches.
#
# It runs SERVER-SIDE ONLY. No key ever reaches a browser or a bundled client:
# anything shipped to a user is readable by that user.
#
# Set ONE of the two keys below. The hackathon requires the Strands Agents SDK,
# not a model vendor — Bedrock and AgentCore are explicitly optional — so either
# provider is a valid submission. Whichever key you have credit on is the right
# one.
#
# The model only ever proposes. Every consequence — dates, thresholds, counts,
# and whether a quoted requirement is really in the document — is computed by
# code that runs with no model at all. That is why swapping providers here is a
# configuration change and not a rewrite.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. With both keys set, anthropic wins; set this to force the other.
#   TENDER_MODEL_PROVIDER=openai
TENDER_MODEL_PROVIDER=

# The model id. Defaults to claude-sonnet-5 for anthropic.
# REQUIRED for openai: no default is shipped, because a guessed model id keeps
# working right up until the day the model is retired, and then fails at the one
# moment it is used.
TENDER_MODEL=

# ---------------------------------------------------------------------------
# AWS. NOT needed to run this project.
#
# strands-agents talks to Anthropic or OpenAI directly. These are here only for
# an optional deployment on Bedrock AgentCore, which the rules describe as
# strengthening the Technical Implementation score without being required.
#
# The AWS Builder ID the submission asks for is a free personal profile
# (profile.aws.amazon.com) and is unrelated to these credentials, to an AWS
# account, and to promotional credits.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
