# Secrets for the agent runtime. Copy to `.env` and fill in.
# Never commit the filled file — `.gitignore` covers it.

# The model that reads the tender pack and proposes matches.
# It runs SERVER-SIDE ONLY. No key ever reaches a browser or a bundled client:
# anything shipped to a user is readable by that user.
ANTHROPIC_API_KEY=

# AWS — used for the hackathon's Strands Agents SDK / Bedrock track.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
